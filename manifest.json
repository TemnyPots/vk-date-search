{
  "manifest_version": 3,
  "name": "ВК: поиск постов по дате",
  "version": "1.0.0",
  "description": "Находит посты на стене сообщества или профиля ВКонтакте за выбранный период.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Поиск постов по дате",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.com/*", "https://vk.ru/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
